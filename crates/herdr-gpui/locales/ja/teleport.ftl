# Teleport: moving a worktree, its tabs, and its agents to another host.
# Host, repository, branch, tab, and program names are data, as are
# commands the destination runs.

teleport-title = Teleport
teleport-subtitle = { $host } から { $worktree }
teleport-no-hosts = 他のホストが保存されていません。デバイスから追加して再試行してください。
teleport-host-connected = 接続済み
teleport-host-ssh = 未接続。SSH 経由で到達します
teleport-checking = { $host } と実行中のプログラムを確認中...
teleport-to-origin = { $host } · { $repository } へ。同じオリジンリモート。
teleport-to-remote = { $host } · { $repository } へ。リモートを共有します。
teleport-to-name = { $host } · { $repository } へ。名前のみ一致し、リモートは異なります。
teleport-to-reclaim = { $host } · { $repository } へ。作業を元のチェックアウトに戻します。
teleport-to-existing = { $host } · { $path } へ。すでにあるチェックアウトを開きます。
teleport-to-clone = { $host } · { $path } へ。先にリポジトリをクローンします。
teleport-to-copy = { $host } · { $path } へ。先にリポジトリをコピーします。
teleport-state = ブランチ { $branch } · 未プッシュコミット { $unpushed } 件 · 変更ファイル { $changed } 件、未追跡 { $untracked } 件
teleport-github-token = { $host } は単独で GitHub に到達できないため、このリポジトリ用に GitHub CLI トークンがそこにインストールされ、git pull と git push に使用されます。
teleport-github-unavailable = { $host } は GitHub に到達できず、ここの GitHub CLI もサインインしていないため、そこではプルとプッシュが機能しません。
teleport-name-only = 名前のみで一致: このリポジトリのリモートはそこで異なります。
teleport-tab = タブ { $number }
teleport-tab-labeled = タブ { $number }: { $label }
teleport-pane-shell = シェル
teleport-pane-resume = { $agent }: セッションを再開
teleport-pane-handoff-again = { $program }: 引き継ぎノートを作成してから再起動
teleport-pane-handoff-to = { $program }: 引き継ぎノート、{ $agent } が続行
teleport-pane-start = { $command } を開始
teleport-pane-run = { $command } を実行
teleport-pane-missing = { $program }: そこにインストールされていないためスキップ
teleport-left-behind = .env などの無視されたファイルは残ります。ここのワークスペースはその後閉じます。チェックアウトは残り、「ワークツリーを開く」で再度開けます。
teleport-moving-to = { $host } に移動中...
teleport-step-starting = 開始中
teleport-step-discover = 一致するリポジトリを検索中
teleport-step-review = 移動をレビュー中
teleport-step-clone = リポジトリを宛先にコピー中
teleport-step-open = 宛先でリポジトリを開いています
teleport-step-handoff = エージェントに引き継ぎノートを依頼中
teleport-step-capture = コミットと変更をキャプチャ中
teleport-step-transfer = 変更を宛先にコピー中
teleport-step-fetch = 宛先でブランチをフェッチ中
teleport-step-create-worktree = 宛先ワークツリーを作成中
teleport-step-restore = 未コミット変更を復元中
teleport-step-tabs = タブを再作成中
teleport-step-retire = ソースワークスペースのプログラムを停止中
teleport-step-credentials = 宛先に GitHub 認証情報をインストール中
teleport-step-sessions = エージェントセッションを移動中
teleport-step-launch = プログラムを起動中
teleport-keeps-moving = このダイアログを閉じても移動は停止しません。
teleport-source-closes-later = 移動元のワークスペースは移動先の準備ができてから閉じます。
teleport-review = レビュー
teleport-moving = 移動中...
teleport-close = 閉じる
teleport-hide = 隠す
teleport-cancel = キャンセル
teleport-failed = Teleport に失敗しました: { $error }
teleport-done = { $host } に Teleport しました
teleport-done-warnings = { $count } 件の警告付きで { $host } に Teleport しました: { $first }
