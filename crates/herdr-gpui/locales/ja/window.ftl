# The main window's own cards over the terminal area: the reconnecting card
# and the daemon's product announcement. Host names and the announcement's
# title and body come from the user and the daemon.

window-reconnecting = { $host } に再接続中
window-reconnect-now = 今すぐ再接続
window-removing = { $host } を削除中
window-device-being-removed = 削除されています。
window-announcement = Herdr { $version }
window-announcement-preview = Herdr { $version } · プレビュー
window-dismiss = 閉じる
window-dismiss-announcement-failed = お知らせを閉じる: { $error }
