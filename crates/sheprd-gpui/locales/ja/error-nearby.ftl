# Failures relaying frames through herdr-nearby, the Bluetooth helper for
# nearby pairing and presence.

error-nearby-malformed = 近接フレームがこのリレーで読み取れる JSON ではありません
error-nearby-pipe = 近接ヘルパーに { $pipe } パイプがありません
error-nearby-spawn = 近接ヘルパーを開始できませんでした
error-nearby-too-large = 近接フレームが { $limit } バイトを超えています
