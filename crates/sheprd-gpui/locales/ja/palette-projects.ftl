# The command palette's project rows: local checkouts under the configured
# project roots, and the row that makes a new one. Paths and URLs are data.

palette-projects-local = ローカル  { $path }
palette-projects-create-folder = フォルダ「{ $name }」を作成
palette-projects-new-in = { $path } に新しいプロジェクト
palette-projects-clone = 「{ $name }」をクローン
palette-projects-clone-into = git clone { $url } を { $path } に
